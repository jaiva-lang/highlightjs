{
    "name": "highlightjs-jaiva",
    "version": "1.1.0",
    "author": "Lehlogonolo Poole",
    "description": "Jaiva Scripting language definition for highlightjs",
    "main": "dist/jaiva.cjs",
    "type": "module",
    "module": "dist/jaiva.es.js",
    "exports": {
        ".": {
            "import": "./dist/jaiva.es.js",
            "require": "./dist/jaiva.cjs"
        }
    },
    "scripts": {
        "build": "rollup -c",
        "pretest": "npm run build",
        "test": "mocha",
        "test-markup": "npm test"
    },
    "files": [
        "src",
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git://github.com/jaiva-lang/highlightjs.git"
    },
    "keywords": [
        "highlight.js",
        "syntax",
        "jaiva",
        "language",
        "highlightjs",
        "syntax",
        "highlight"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/jaiva-lang/highlightjs/issues"
    },
    "homepage": "https://github.com/jaiva-lang/highlightjs",
    "peerDependencies": {
        "highlight.js": "^11.11.0"
    },
    "devDependencies": {
        "glob": "^13.0.6",
        "highlight.js": "^11.12.0",
        "eslint": "^10.13.0",
        "mocha": "^12.0.3",
        "should": "^13.2.3",
        "rollup": "^4.64.12"
    }
}
